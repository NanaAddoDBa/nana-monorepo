{
  "name": "aventra-enquiry-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run typecheck",
    "ci": "npm run typecheck && npm run test",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "notify": "node --experimental-strip-types src/notifications/worker.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "pg": "^8.13.3",
    "zod": "^3.25.76",
    "nodemailer": "^7.0.6",
    "stripe": "^23.0.1",
    "fastify-raw-body": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/nodemailer": "^7.0.1",
    "typescript": "^5.8.3"
  }
}
