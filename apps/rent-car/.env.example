# Public, non-secret contact details. Vite embeds VITE_* variables in the frontend.
# Optional public frontend values; set AVENTRA_* GitHub Actions variables for deploys.
VITE_BOOKING_EMAIL=
VITE_CONTACT_PHONE=
VITE_BASE_PATH=/rent-car-react/
# Only change to true after fleet, prices, policies, and booking email are verified.
VITE_PRODUCTION_READY=false
# Enable only when rent-car-api, PostgreSQL and verified operator inventory are running.
VITE_ENQUIRY_API_URL=
VITE_ENABLE_LIVE_ENQUIRIES=false

# Enable only after the deployed backend has verified fleet, taxes/fees,
# signed Stripe webhooks, pickup operations and a tested payment journey.
VITE_ENABLE_PAID_BOOKINGS=false
